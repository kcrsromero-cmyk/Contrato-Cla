# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth Provider (OIDC — compatible con Supabase, Auth0, Keycloak, etc.)
SUPABASE_URL="https://your-auth-project.example.com"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
AUTH_JWKS_URL="https://your-auth-provider.example.com/.well-known/jwks.json"
# Opcional: emisor/audiencia esperados del JWT. Por defecto: AUTH_JWKS_URL sin "/.well-known/jwks.json" y "authenticated" (Supabase).
# AUTH_JWT_ISSUER="https://your-project.supabase.co/auth/v1"
# AUTH_JWT_AUDIENCE="authenticated"

# Frontend / CORS
FRONTEND_URL="http://localhost:3000"

# Open Data Source
SOCRATA_APP_TOKEN="your-app-token"
SOCRATA_DATASET_URL="https://your-data-source.example.com/resource/dataset-id.json"

# Server
PORT=4000
# Nº de proxies de confianza delante de la API (Traefik/Coolify = 1). No publicar el puerto de la API directamente a Internet.
TRUST_PROXY=1
