# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth Provider (OIDC — compatible con Supabase, Auth0, Keycloak, etc.)
SUPABASE_URL="https://your-auth-project.example.com"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
AUTH_JWKS_URL="https://your-auth-provider.example.com/.well-known/jwks.json"

# Frontend / CORS
FRONTEND_URL="http://localhost:3000"

# Open Data Source
SOCRATA_APP_TOKEN="your-app-token"
SOCRATA_DATASET_URL="https://your-data-source.example.com/resource/dataset-id.json"

# Server
PORT=4000
